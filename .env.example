# Copy to liq-bot.env inside your workspace dir. Never commit real secrets.
# Bot wallet address = account derived from this mnemonic (Python + dashboard).
LIQUIDATION_BOT_MNEMONIC="your 25-word algorand mnemonic here"

# Optional: override workspace (env file, state, log). Default: ~/.openclaw/workspace
# LIQ_BOT_WORKSPACE="/path/to/your/config"

# Optional: Node executable for runners (default: node from PATH)
# LIQ_BOT_NODE="node"

# Optional: MCP repo paths (runners + dashboard + Python contracts). Will be replaced by UluOS gateway in the future.
# DORKFI_MCP_PATH="/path/to/DorkFiMCP"
# HUMBLE_MCP_PATH="/path/to/HumbleSwapMCP"

# Optional: Telegram alerts. Token from TELEGRAM_BOT_TOKEN here, or from openclaw.json
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
